+def test_rollback_codes_are_published_only_by_fixed_literal_allowlist():
+    """Do not accept a new guard error without updating the safe workflow list."""
+    import re
+    protected = ast.parse((ROOT / "scripts/desktop_orchestrator_protected_state.py").read_text(encoding="utf-8"))
+    definitions = [node for node in protected.body if isinstance(node, ast.Assign)
+                   and any(isinstance(target, ast.Name) and target.id == "SAFE_ROLLBACK_BLOCKERS"
+                           for target in node.targets)]
+    assert len(definitions) == 1
+    safe = set(ast.literal_eval(definitions[0].value.args[0]))
+
+    workflow = WORKFLOW.read_text(encoding="utf-8")
+    match = re.search(
+        r"\$approvedBlockers = @\((.*?)\)\s+if \(\$proofFailed\.blocker_code",
+        workflow, flags=re.DOTALL,
+    )
+    assert match is not None
+    approved = set(re.findall(r"'([A-Z][A-Z0-9_]+)'", match.group(1)))
+    assert safe <= approved
+
+
